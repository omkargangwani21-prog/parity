# Copy to .env and fill in. NEVER commit .env or paste the key anywhere public.
# Currently pointing at the free NVIDIA API; switch to Nebius Token Factory below.
NEBIUS_BASE_URL=https://integrate.api.nvidia.com/v1
NEBIUS_API_KEY=your-key-here
PARITY_MODEL_ULTRA=nvidia/nemotron-3-ultra-550b-a55b

# --- Nebius Token Factory (get exact model ids from GET /v1/models) ---
# NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# PARITY_MODEL_ULTRA=<org/model-id from /v1/models>

# --- Optional tuning (defaults shown) ---
# PARITY_UI_TIERS=ultra
# PARITY_TIME_BUDGET=600
# PARITY_CALL_SECS=480
# PARITY_MAX_TOKENS=20000
# PARITY_THINK=auto
# PARITY_DAILY_CAP=300
# PARITY_MAX_JOBS=2
# PORT=8000
